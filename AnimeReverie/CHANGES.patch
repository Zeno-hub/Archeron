diff -ruN a/AnimeReverie/ReplicatedStorage/SharedModules/GachaLogic.lua b/AnimeReverie/ReplicatedStorage/SharedModules/GachaLogic.lua
--- a/AnimeReverie/ReplicatedStorage/SharedModules/GachaLogic.lua	1970-01-01 00:00:00.000000000 +0000
+++ b/AnimeReverie/ReplicatedStorage/SharedModules/GachaLogic.lua	2026-10-24 03:42:43.079834198 +0000
@@ -0,0 +1,56 @@
+--!nonstrict
+--[[
+	GachaLogic | ModuleScript | ReplicatedStorage > SharedModules > GachaLogic
+	Logika gacha MURNI (undian berbobot, validasi peluang, bonus pet, multiplier Power gacha).
+	Pembayaran, penyimpanan, dan pemanggilan Roll terjadi di SERVER (service gacha, belum dibuat).
+	State multiplier memakai key string "W<id>" (DataStore tidak boleh key angka non-urut).
+]]
+local GachaLogic = {}
+
+-- Return: ok, jumlah. Tabel valid bila semua Weight > 0 dan jumlahnya TEPAT 100.
+function GachaLogic.ValidateOdds(entries)
+	local sum = 0
+	for _, e in entries do
+		if type(e.Weight) ~= "number" or e.Weight ~= e.Weight or e.Weight <= 0 then return false, "InvalidWeight" end
+		sum += e.Weight
+	end
+	return math.abs(sum - 100) < 1e-9, sum
+end
+
+function GachaLogic.Roll(entries, rng)
+	rng = rng or math.random
+	local total = 0
+	for _, e in entries do total += e.Weight end
+	local r, acc = rng() * total, 0
+	for _, e in entries do
+		acc += e.Weight
+		if r < acc then return e end
+	end
+	return entries[#entries]
+end
+
+-- Total bonus pet yang di-equip: 1 + jumlah ClickBonus.
+function GachaLogic.PetClickMultiplier(equippedPets)
+	local bonus = 0
+	for _, pet in equippedPets do bonus += pet.ClickBonus end
+	return 1 + bonus
+end
+
+-- best: { ["W1"] = multiplier terbaik }. Return true bila hasil pull lebih baik dari yang tercatat.
+function GachaLogic.RecordPowerPull(best, worldId, entry)
+	local key = "W" .. worldId
+	if entry.Multiplier > (best[key] or 1) then
+		best[key] = entry.Multiplier
+		return true
+	end
+	return false
+end
+
+-- Multiplier aktif = 1 + jumlah (terbaik tiap world - 1).
+function GachaLogic.ActiveMultiplier(best)
+	local total = 1
+	for _, m in best do total += math.max(0, m - 1) end
+	return total
+end
+
+return GachaLogic
diff -ruN a/AnimeReverie/ReplicatedStorage/SharedModules/QuestLogic.lua b/AnimeReverie/ReplicatedStorage/SharedModules/QuestLogic.lua
--- a/AnimeReverie/ReplicatedStorage/SharedModules/QuestLogic.lua	1970-01-01 00:00:00.000000000 +0000
+++ b/AnimeReverie/ReplicatedStorage/SharedModules/QuestLogic.lua	2026-10-24 03:42:43.080266388 +0000
@@ -0,0 +1,51 @@
+--!nonstrict
+--[[
+	QuestLogic | ModuleScript | ReplicatedStorage > SharedModules > QuestLogic
+	Logika quest kill MURNI. state = { [questId] = { Progress, Status } }, Status: "Active" -> "Completed" -> "Claimed".
+	Kill hanya dihitung bila world & musuh cocok dengan target quest, dan hanya saat Active (satu kill tidak bisa
+	dihitung dua kali oleh quest yang sama). Reward hanya keluar sekali lewat Claim.
+]]
+local QuestLogic = {}
+
+local function entry(state, id)
+	local s = state[id]
+	if not s then
+		s = { Progress = 0, Status = "Active" }
+		state[id] = s
+	end
+	return s
+end
+
+-- Panggil SETELAH server mengonfirmasi satu kill. Return: daftar id quest yang baru menjadi Completed.
+function QuestLogic.OnKill(state, quests, worldId, enemyId)
+	local completed = {}
+	for _, q in quests do
+		if q.WorldId == worldId and table.find(q.TargetEnemyIds, enemyId) then
+			local s = entry(state, q.Id)
+			if s.Status == "Active" then
+				s.Progress = math.min(q.Goal, s.Progress + 1)
+				if s.Progress >= q.Goal then
+					s.Status = "Completed"
+					table.insert(completed, q.Id)
+				end
+			end
+		end
+	end
+	return completed
+end
+
+-- Return: true, reward  ATAU  false, "NotCompleted" | "AlreadyClaimed"
+function QuestLogic.Claim(state, quest)
+	local s = state[quest.Id]
+	if s and s.Status == "Claimed" then return false, "AlreadyClaimed" end
+	if not s or s.Status ~= "Completed" then return false, "NotCompleted" end
+	s.Status = "Claimed"
+	return true, quest.Reward
+end
+
+function QuestLogic.Summary(state, quest)
+	local s = state[quest.Id]
+	return { Progress = s and s.Progress or 0, Goal = quest.Goal, Status = s and s.Status or "Active" }
+end
+
+return QuestLogic
